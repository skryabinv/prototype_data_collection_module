# База: compile_commands.json из CMake (build/Debug).
# Не добавляйте CompileFlags.Add — иначе clangd теряет пути libstdc++ от arm-none-eabi-g++.
CompileFlags:
  CompilationDatabase: build/Debug

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

Format:
  Style: file

---
# HAL, CMSIS, FreeRTOS — только для сборки, не для правок clangd.
If:
  PathMatch: .*(/|\\)(Drivers|Middlewares)(/|\\).*
Diagnostics:
  Suppress: '*'
Index:
  Background: Skip

---
# Vendor API датчика (Bosch bmp3) — не анализируем.
If:
  PathMatch: .*(/|\\)vendor(/|\\).*
Diagnostics:
  Suppress: '*'
Index:
  Background: Skip

---
# CubeMX C в Core/Src — правки только в USER CODE, диагностику clangd отключаем.
If:
  PathMatch: .*(/|\\)Core(/|\\)Src(/|\\).*\.c$
Diagnostics:
  Suppress: '*'
Index:
  Background: Skip

---
If:
  PathMatch: .*startup_.*\.s$
Diagnostics:
  Suppress: '*'
Index:
  Background: Skip
